{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "vitest run tests/contract.test.ts",
    "check:admin": "vitest run tests/admin.test.tsx",
    "audit": "npm run build && tsx --tsconfig tsconfig.scripts.json scripts/audit.ts",
    "share-preview": "tsx --tsconfig tsconfig.scripts.json scripts/makeSharePreview.ts",
    "sample-data": "tsx --tsconfig tsconfig.scripts.json scripts/makeSampleData.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
